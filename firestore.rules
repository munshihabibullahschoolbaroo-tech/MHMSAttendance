rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenEmail() {
      return request.auth.token.email;
    }

    function isSuperAdminEmail() {
      return signedIn() && tokenEmail() == 'munshihabibullahschoolbaroo@gmail.com';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function myRole() {
      return userDoc(request.auth.uid).data.role;
    }

    function isAdmin() {
      return signedIn() && (
        isSuperAdminEmail() ||
        (userExists(request.auth.uid) && (
          myRole() == 'admin' ||
          myRole() == 'super_admin'
        ))
      );
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == tokenEmail();

      allow update: if signedIn() && (
        isSuperAdminEmail() ||
        isAdmin() ||
        (request.auth.uid == userId && (
          // Allow self to update timezone or phone without changing role
          request.resource.data.role == resource.data.role
        ))
      );

      allow delete: if isSuperAdminEmail() || (signedIn() && request.auth.uid == userId);
    }

    // --- TEACHER STAFF ATTENDANCE ---
    match /attendance/{docId} {
      allow read: if signedIn() && (
        resource.data.workerId == request.auth.uid || isAdmin()
      );
      allow create, update: if signedIn() && (
        request.resource.data.workerId == request.auth.uid || isAdmin()
      );
      allow delete: if signedIn() && (
        resource.data.workerId == request.auth.uid || isAdmin()
      );
    }

    // --- TEACHER STAFF SESSIONS (PRIMARY MHMS ATTENDANCE) ---
    match /teacherSessions/{docId} {
      allow read: if signedIn() && (
        resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow create, update: if signedIn() && (
        request.resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- SCHOOL CAMPUS & WING CONFIGURATION ---
    match /schoolConfig/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- STUDENTS ROSTER ---
    match /students/{studentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- STUDENT DAILY ATTENDANCE RECORDS ---
    match /studentAttendance/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- STAFF LEAVE REQUESTS ---
    match /leaveRequests/{id} {
      allow read: if signedIn() && (
        resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- CLASS SWITCH REQUESTS ---
    match /classSwitchRequests/{id} {
      allow read: if signedIn() && (
        resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- CLASS TEACHER DELEGATIONS ---
    match /classTeacherDelegations/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- CLASS TEACHER ASSIGNMENT REQUESTS ---
    match /classTeacherAssignmentRequests/{id} {
      allow read: if signedIn() && (
        resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- MANUAL PUNCH REQUESTS ---
    match /manualPunchRequests/{id} {
      allow read: if signedIn() && (
        resource.data.workerId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && isAdmin();
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // --- DEFAULT DENY ALL OTHER ACCESS ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
